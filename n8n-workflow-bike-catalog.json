    {
      "parameters": {
        "jsCode": "// รับข้อมูล catalog จาก Admin Panel\nconst body = $input.first().json.body || $input.first().json;\nconst catalog = body.catalog || [];\n\nif (catalog.length === 0) {\n  return [{ json: { sql: 'DELETE FROM bike_catalog;', count: 0 } }];\n}\n\n// สร้าง SQL: DELETE ทั้งหมด แล้ว INSERT ใหม่\nconst esc = (s) => String(s||'').replace(/'/g, \"''\");\n\nconst values = catalog.map((c, i) => {\n  const bt   = esc(c.bike_type);\n  const mn   = esc(c.model_name);\n  const vn   = esc(c.variant_name || '');\n  const sm   = esc(c.submodel_name || '');\n  const mkt  = esc(c.marketing_name || '');\n  const cc   = parseInt(c.engine_cc) || 0;\n  const tr   = esc(c.transmission || 'Automatic');\n  const ia   = (c.is_active !== false && c.is_active !== 0) ? 'true' : 'false';\n  const so   = parseInt(c.sort_order) || i;\n  const note = esc(c.note || '');\n  return `('${bt}','${mn}','${vn}','${sm}','${mkt}',${cc},'${tr}',${ia},${so},'${note}',NOW())`;\n});\n\nconst sql = `DELETE FROM bike_catalog;\\nINSERT INTO bike_catalog (bike_type,model_name,variant_name,submodel_name,marketing_name,engine_cc,transmission,is_active,sort_order,note,updated_at) VALUES ${values.join(',')};`;\n\nreturn [{ json: { sql, count: catalog.length } }];"
      },
      "id": "bc200002-cafe-4000-b002-porpaor000002",
      "name": "Build SQL",
      "type": "n8n-nodes-base.code",
