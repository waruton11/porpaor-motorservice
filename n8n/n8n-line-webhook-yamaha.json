{
  "name": "LINE Yamaha (สิงห์ชัย)",
  "nodes": [
    {
      "id": "y0-push-001",
      "name": "POST push-lead-card-yamaha",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "push-lead-card-yamaha",
      "parameters": {
        "httpMethod": "POST",
        "path": "push-lead-card-yamaha",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "y0-push-002",
      "name": "Build push",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst userId = body.userId;\nconst message = body.message;\nif (!userId || !message) return [{ json: { ok: false, skip: true } }];\nreturn [{ json: { userId, message, token: 'YAMAHA_TOKEN_HERE' } }];"
      }
    },
    {
      "id": "y0-push-003",
      "name": "LINE Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $json.token }}" }]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ to: $json.userId, messages: [$json.message] }) }}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      }
    },
    {
      "id": "y0-push-004",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json || {};\nconst status = r.statusCode || r.status || 0;\nreturn [{ json: { ok: status >= 200 && status < 300, status } }];"
      }
    },
    {
      "id": "y0-push-005",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1080, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: $json.ok, status: $json.status }) }}",
        "options": {}
      }
    },
    {
      "id": "y1-ack-001",
      "name": "POST ack-lead-yamaha",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 520],
      "webhookId": "ack-lead-yamaha",
      "parameters": {
        "httpMethod": "POST",
        "path": "ack-lead-yamaha",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "y1-ack-002",
      "name": "Build ack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 520],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst userId = body.userId;\nif (!userId) return [{ json: { skip: true } }];\n\nfunction qr(items) {\n  return { items: items.map(it => ({ type: 'action', action: { type: 'message', label: it.label, text: it.text } })) };\n}\n\nconst message = {\n  type: 'text',\n  text: 'ขอบคุณที่สนใจ Yamaha กับ สิงห์ชัยสยามยนต์ครับ 🙏\\nทีมงานได้รับรุ่นที่คุณเลือกแล้ว เดี๋ยวเจ้าหน้าที่ติดต่อกลับนะครับ\\n\\nสะดวกให้ติดต่อแบบไหนดีครับ?',\n  quickReply: qr([\n    { label: '📞 โทรได้เลย', text: 'พร้อมให้โทรได้เลย' },\n    { label: '⏰ นัดเวลาโทร', text: 'ขอนัดเวลาให้โทร' },\n    { label: '💬 ขอแชทก่อน', text: 'ขอสอบถามทางแชทก่อน' }\n  ])\n};\n\nreturn [{ json: { userId, message, token: 'YAMAHA_TOKEN_HERE' } }];"
      }
    },
    {
      "id": "y1-ack-005",
      "name": "Show Typing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 520],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/chat/loading/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $('Build ack').item.json.token }}" }]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chatId: $('Build ack').item.json.userId, loadingSeconds: 5 }) }}",
        "options": {}
      }
    },
    {
      "id": "y1-ack-006",
      "name": "Wait 2s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [860, 520],
      "webhookId": "wait-ack-yamaha",
      "parameters": { "amount": 2, "unit": "seconds" }
    },
    {
      "id": "y1-ack-003",
      "name": "LINE Push 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 520],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $('Build ack').item.json.token }}" }]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ to: $('Build ack').item.json.userId, messages: [$('Build ack').item.json.message] }) }}",
        "options": {}
      }
    },
    {
      "id": "y1-ack-004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 520],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      }
    },
    {
      "id": "y2-oa-001",
      "name": "LINE Webhook Yamaha",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 740],
      "webhookId": "line-oa-yamaha",
      "parameters": {
        "httpMethod": "POST",
        "path": "line-oa-yamaha",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "y2-oa-002",
      "name": "Process LINE Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 740],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TOKEN = 'YAMAHA_TOKEN_HERE';\nconst LIFF_URL = 'https://liff.line.me/2010557863-oPg9ROHK';\nconst BRAND_COLOR = '#0a3aa0';\n// ... (see IMPORT-LINE-yamaha.json for full bot logic)"
      }
    },
    {
      "id": "y2-oa-004",
      "name": "Show Typing 3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 740],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/chat/loading/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $('Process LINE Events').item.json.token }}" }]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chatId: $('Process LINE Events').item.json.userId, loadingSeconds: 5 }) }}",
        "options": {}
      }
    },
    {
      "id": "y2-oa-005",
      "name": "Wait 2s 3",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [860, 740],
      "webhookId": "wait-line-yamaha-reply",
      "parameters": { "amount": 2, "unit": "seconds" }
    },
    {
      "id": "y2-oa-003",
      "name": "Send LINE Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 740],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $('Process LINE Events').item.json.token }}" }]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ replyToken: $('Process LINE Events').item.json.replyToken, messages: $('Process LINE Events').item.json.messages }) }}",
        "options": {}
      }
    },
    {
      "id": "y2-oa-006",
      "name": "Save Phone",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [640, 920],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.savePhone ? (\"UPDATE customers SET phone='\" + $json.savePhone + \"', last_seen=NOW() WHERE line_user_id='\" + $json.userId + \"'; UPDATE leads SET cust_phone='\" + $json.savePhone + \"' WHERE line_user_id='\" + $json.userId + \"' AND (cust_phone IS NULL OR cust_phone='');\") : \"SELECT 1;\" }}",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    }
  ],
  "connections": {
