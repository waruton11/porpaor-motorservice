      "id": "bb4dac95-b081-441b-8f3d-a4b77def206c",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst result = [];\n\nfor (const item of rows) {\n  const vals = Object.values(item.json);\n  const modelName = vals[0];\n  const typeField = String(vals[1] || '').trim();\n  const priceCash = Number(vals[4]); // col E = ราคาขาย\n\n  if (!modelName || !typeField || priceCash < 1000) continue;\n  if (typeof modelName !== 'string' || !/^[A-Za-z]/.test(modelName)) continue;\n  if (typeField.includes('(')) continue; // ข้ามรุ่นพิเศษ\n\n  // แยก \"NSS350AS 2TH\" → variant=\"NSS350AS\", type=\"2TH\"\n  const parts = typeField.split(' ');\n  if (parts.length < 2) continue;\n  const type = parts[parts.length - 1];\n  const variant = parts.slice(0, -1).join('').trim();\n\n  if (!type.includes('TH')) continue;\n\n  result.push({\n    json: {\n      variant: variant,\n      type: type,\n      price_cash: priceCash,\n      price_finance: priceCash\n    }\n  });\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "6e4d9d8f-7e72-4277-a52a-ae2ca9ce53d7",
      "name": "Code"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE car_prices \nSET \n  price_cash_paopao = {{ $json.price_cash }},\n  price_finance_paopao = {{ $json.price_finance }},\n  updated_at = NOW()\nWHERE variant = '{{ $json.variant }}'\n  AND type = '{{ $json.type }}';",
        "options": {}
      },
