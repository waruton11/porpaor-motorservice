{
  "name": "POST login",
  "nodes": [
    {
      "id": "lg-001",
      "name": "POST login",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "login",
      "parameters": {
        "httpMethod": "POST",
        "path": "login",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "lg-002",
      "name": "Build Q",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst esc = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\nconst sql = `SELECT username, role, name FROM users WHERE username = '${esc(b.username)}' AND password = '${esc(b.password)}' AND active = true LIMIT 1;`;\nreturn [{ json: { sql } }];"
      }
    },
    {
      "id": "lg-003",
      "name": "Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        640,
        300
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "lg-004",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all();\nif (rows.length && rows[0].json && rows[0].json.role) {\n  const u = rows[0].json;\n  return [{ json: { ok: true, role: u.role, name: u.name || u.username, username: u.username } }];\n}\nreturn [{ json: { ok: false } }];"
      }
    },
    {
      "id": "lg-005",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    }
  ],
