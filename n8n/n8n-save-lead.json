      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst esc = (s) => (s == null || s === '') ? 'NULL' : `'${String(s).replace(/'/g, \"''\")}'`;\nconst num = (n) => (n == null || n === '' || isNaN(Number(n))) ? 'NULL' : Number(n);\nconst detail = JSON.stringify(b.detail || {}).replace(/'/g, \"''\");\nconst sql = `INSERT INTO leads (lead_type, model, variant, color, pay_type, down_pct, installment, period, price, cust_name, cust_phone, line_user_id, detail)\nVALUES (${esc(b.lead_type)}, ${esc(b.model)}, ${esc(b.variant)}, ${esc(b.color)}, ${esc(b.pay_type)}, ${num(b.down_pct)}, ${num(b.installment)}, ${num(b.period)}, ${num(b.price)}, ${esc(b.cust_name)}, ${esc(b.cust_phone)}, ${esc(b.line_user_id)}, '${detail}'::jsonb);`;\nreturn [{ json: { sql } }];"
      }
    },
    {
      "id": "lead-003",
      "name": "Insert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
