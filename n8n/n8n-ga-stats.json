        "jsCode": "const r = ($input.first() && $input.first().json) || {};\nconst src = Array.isArray(r.rows) ? r.rows : [];\nconst rows = src.map(function(row){\n  const d = (row.dimensionValues && row.dimensionValues[0] && row.dimensionValues[0].value) || '';\n  const users = Number((row.metricValues && row.metricValues[0] && row.metricValues[0].value) || 0);\n  const views = Number((row.metricValues && row.metricValues[1] && row.metricValues[1].value) || 0);\n  return { date: d, users: users, views: views };\n});\nreturn [{ json: { ok: true, rows } }];"
      }
