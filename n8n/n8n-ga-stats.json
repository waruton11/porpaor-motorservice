    {
      "id": "ga-shape",
      "name": "Shape rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = $input.all().map(i => i.json);\nlet rows = [];\nfunction fromRaw(r){\n  const d = (r.dimensionValues && r.dimensionValues[0] && r.dimensionValues[0].value) || '';\n  const users = Number((r.metricValues && r.metricValues[0] && r.metricValues[0].value) || 0);\n  const views = Number((r.metricValues && r.metricValues[1] && r.metricValues[1].value) || 0);\n  return { date: String(d), users, views };\n}\nif (all.length && Array.isArray(all[0].rows)) {\n  rows = all[0].rows.map(fromRaw);\n} else {\n  rows = all.map(function(r){\n    if (Array.isArray(r.dimensionValues)) return fromRaw(r);\n    return { date: String(r.date || ''), users: Number(r.totalUsers || r.activeUsers || r.active1DayUsers || r.newUsers || 0), views: Number(r.screenPageViews || r.pageViews || 0) };\n  });\n}\nrows = rows.filter(function(r){ return r.date; });\nreturn [{ json: { ok: true, rows } }];"
      }
