        "jsCode": "const body = $('POST update-catalog-freebies').first().json.body || $('POST update-catalog-freebies').first().json;\nconst items = body.items || [];\nif (items.length === 0) return [{ json: { sql: 'SELECT 1;', count: 0 } }];\nconst esc = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\nconst stmts = items.map(it => {\n  const sm = esc(it.submodel_name);\n  const fb = esc(JSON.stringify(Array.isArray(it.freebies) ? it.freebies : []));\n  return `UPDATE bike_catalog SET freebies = '${fb}'::jsonb WHERE submodel_name = '${sm}';`;\n}).join('\\n');\nreturn [{ json: { sql: stmts, count: items.length } }];"
