        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst userId = body.userId;\nconst message = body.message;\nif (!userId || !message) return [{ json: { ok: false, skip: true } }];\nreturn [{ json: { userId, message, token: 's6yXmBDu8IHtcIJA54MOVUqxVPNUSwht/oAxwGR+HyZ2H6cbrRS+i2BGQzfQRsCk8rUiVuGiYVSFVqsgW5SJXNIZHi736tS59Q/yJMP7TVfCA0Lot7p1NYu8ERe2tvh3ipTN12+bFfCTQ/8U0ShzYAdB04t89/1O/w1cDnyilFU=' } }];"
