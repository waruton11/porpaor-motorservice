    {
      "id": "us-s-002",
      "name": "Build user SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('POST save-user').first().json.body || $('POST save-user').first().json;\nconst esc = (s) => (s == null || s === '') ? 'NULL' : `'${String(s).replace(/'/g, \"''\")}'`;\nconst num = (n) => (n == null || n === '' || isNaN(Number(n))) ? 'NULL' : Number(n);\nconst act = (b.active === false) ? 'false' : 'true';\nlet sql;\nif (b.id) {\n  const sets = [`username = ${esc(b.username)}`, `role = ${esc(b.role)}`, `name = ${esc(b.name)}`, `active = ${act}`];\n  if (b.password) { sets.push(`password_hash = crypt(${esc(b.password)}, gen_salt('bf'))`); }\n  if (b.email !== undefined) sets.push(`email = ${esc(b.email)}`);\n  sql = `UPDATE users SET ${sets.join(', ')} WHERE id = ${num(b.id)};`;\n} else {\n  sql = `INSERT INTO users (username, password_hash, role, name, email, active) VALUES (${esc(b.username)}, crypt(${esc(b.password)}, gen_salt('bf')), ${esc(b.role)}, ${esc(b.name)}, ${esc(b.email)}, ${act}) ON CONFLICT (username) DO UPDATE SET password_hash = EXCLUDED.password_hash, role = EXCLUDED.role, name = EXCLUDED.name, email = EXCLUDED.email, active = EXCLUDED.active;`;\n}\nreturn [{ json: { sql } }];"
      }
