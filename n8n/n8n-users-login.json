      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst esc = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\nconst u = esc(b.username), p = esc(b.password);\nconst sql = `WITH ok AS (SELECT username, role, name FROM users WHERE username = '${u}' AND active = true AND password_hash = crypt('${p}', password_hash) LIMIT 1) INSERT INTO sessions (token, username, role, name, expires_at) SELECT gen_random_uuid()::text, username, role, name, NOW() + interval '30 days' FROM ok RETURNING token, role, name, username;`;\nreturn [{ json: { sql } }];"
      }
    },
