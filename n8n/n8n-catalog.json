    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT\n  bc.id, bc.bike_type, bc.submodel_name, bc.model_name, bc.variant_name,\n  bc.badge, bc.colors, bc.engine_cc, bc.is_active, bc.sort_order,\n  bc.auto_rate, bc.auto_rate_unit, bc.auto_down_pcts, bc.auto_rate2,\n  bc.auto_rate2_min_down, bc.auto_rates_by_term, bc.freebies, pl.price, pl.finance_price\nFROM bike_catalog bc\nLEFT JOIN price_list pl\n  ON bc.model_name = pl.model_code AND bc.variant_name = pl.variant_code\nWHERE bc.is_active = true AND bc.brand = '{{ $json.query.brand === 'yamaha' ? 'yamaha' : 'honda' }}'\nORDER BY bc.sort_order ASC, bc.id ASC;",
        "options": {}
