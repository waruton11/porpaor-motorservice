    {
      "parameters": {
        "jsCode": "// รับ rates array จาก admin.html (รุ่นรถ & ราคา)\n// แต่ละ item: { submodel_name, auto_rate, auto_rate_unit, auto_down_pcts, auto_rate2, auto_rate2_min_down }\nconst body = $('POST update-catalog-rates').first().json.body || $('POST update-catalog-rates').first().json;\nconst rates = body.rates || [];\n\nif (rates.length === 0) {\n  return [{ json: { sql: 'SELECT 1;', count: 0 } }];\n}\n\nconst esc = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\n\n// UPDATE bike_catalog ด้วย exact submodel_name match (ไม่ใช้ LIKE)\nconst statements = rates.map(r =>\n  `UPDATE bike_catalog SET auto_rate=${parseFloat(r.auto_rate)||0}, auto_rate_unit='${esc(r.auto_rate_unit||'month')}', auto_down_pcts='${esc(r.auto_down_pcts)}', auto_rate2=${parseFloat(r.auto_rate2)||0}, auto_rate2_min_down=${parseInt(r.auto_rate2_min_down)||0}, auto_rates_by_term='${esc(r.auto_rates_by_term)}' WHERE submodel_name = '${esc(r.submodel_name)}';`\n).join('\\n');\n\nreturn [{ json: { sql: statements, count: rates.length } }];"
