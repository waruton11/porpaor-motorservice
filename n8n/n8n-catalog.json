    {
      "parameters": {
        "jsCode": "// รับ array ราคาจาก admin.html\nconst body = $('POST save-price-list').first().json.body || $('POST save-price-list').first().json;\nconst prices = body.prices || [];\n\nif (prices.length === 0) {\n  return [{ json: { sql: 'SELECT 1;', count: 0 } }];\n}\n\n// สร้าง VALUES string สำหรับ UPSERT\nconst esc = (s) => String(s || '').replace(/'/g, \"''\");\n\nconst values = prices.map(p => {\n  const mc = esc(p.model_code);\n  const vc = esc(p.variant_code || '');\n  const pr = parseInt(p.price) || 0;\n  const fp = parseInt(p.finance_price) || 0;\n  const ft = esc(p.file_type || 'small');\n  return `('${mc}','${vc}',${pr},${fp},'${ft}',NOW())`;\n}).join(',');\n\nconst sql = `INSERT INTO price_list (model_code, variant_code, price, finance_price, file_type, updated_at)\nVALUES ${values}\nON CONFLICT (model_code, variant_code)\nDO UPDATE SET\n  price = EXCLUDED.price,\n  finance_price = EXCLUDED.finance_price,\n  file_type = EXCLUDED.file_type,\n  updated_at = NOW();`;\n\nreturn [{ json: { sql, count: prices.length } }];"
      },
      "id": "becd46e2-7584-4e6f-aaae-7a6b1f14f3a5",
      "name": "Build Upsert SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        752
      ]
    },
