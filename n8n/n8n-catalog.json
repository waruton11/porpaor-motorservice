    {
      "parameters": {
        "httpMethod": "POST",
        "path": "save-bike-catalog",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b0fb8d9-98d8-47dd-a77e-770ef8509304",
      "name": "POST save-bike-catalog",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        208,
        400
      ],
      "webhookId": "save-bike-catalog"
    },
    {
      "parameters": {
        "jsCode": "// รับ catalog array จาก admin.html\nconst body = $('POST save-bike-catalog').first().json.body || $('POST save-bike-catalog').first().json;\nconst catalog = body.catalog || [];\nconst brand = (body.brand === 'yamaha') ? 'yamaha' : 'honda';\n\nconst esc = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\nconst boolVal = (v) => (v === true || v === 'true' || v === 1) ? 'true' : 'false';\n\nlet sql;\n\nif (catalog.length === 0) {\n  sql = 'SELECT 1;';\n} else {\n  const cols = [\n    'bike_type','submodel_name','model_name','variant_name','marketing_name',\n    'engine_cc','transmission','is_active','sort_order','note','badge','colors',\n    'auto_rate','auto_rate_unit','auto_down_pcts','auto_rate2','auto_rate2_min_down','auto_rates_by_term','brand'\n  ].join(',');\n\n  const values = catalog.map(c =>\n    `('${esc(c.bike_type)}','${esc(c.submodel_name)}','${esc(c.model_name)}','${esc(c.variant_name)}','${esc(c.marketing_name)}',${parseInt(c.engine_cc)||0},'${esc(c.transmission||'Automatic')}',${boolVal(c.is_active)},${parseInt(c.sort_order)||0},'${esc(c.note)}','${esc(c.badge||'')}','${esc(c.colors)}',${parseFloat(c.auto_rate)||0},'${esc(c.auto_rate_unit||'month')}','${esc(c.auto_down_pcts)}',${parseFloat(c.auto_rate2)||0},${parseInt(c.auto_rate2_min_down)||0},'${esc(c.auto_rates_by_term)}','${brand}')`\n  ).join(',\\n');\n\n  sql = `DELETE FROM bike_catalog WHERE brand = '${brand}';\\nINSERT INTO bike_catalog (${cols})\\nVALUES\\n${values};`;\n}\n\nreturn [{ json: { sql, count: catalog.length } }];"
      },
