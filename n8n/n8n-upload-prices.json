    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst result = [];\n\nfor (const item of rows) {\n  const vals = Object.values(item.json);\n  const variant = vals[0];\n  const type = vals[1];\n  const priceCash = Number(vals[6]);\n  const priceFinance = Number(vals[12]);\n\n  // กรองเฉพาะแถวที่มีรหัสรุ่นถูกต้อง และราคา > 1000\n  if (\n    typeof variant === 'string' &&\n    variant.length > 3 &&\n    /^[A-Za-z]/.test(variant) &&\n    priceCash > 1000\n  ) {\n    result.push({\n      json: {\n        variant: variant.trim(),\n        type: String(type || 'TH').trim(),\n        price_cash: priceCash,\n        price_finance: priceFinance > 1000 ? priceFinance : priceCash\n      }\n    });\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "de43e041-0c34-42c9-9845-78f11c31c9a4",
      "name": "Code"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE car_prices \nSET \n  price_cash_paopao = {{ $json.price_cash }},\n  price_finance_paopao = {{ $json.price_finance }},\n  updated_at = NOW()\nWHERE variant = '{{ $json.variant }}'\n  AND type = '{{ $json.type }}';",
