      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst hero = String(body.heroImage || '').replace(/'/g, \"''\");\nconst benefits = JSON.stringify(body.benefits || []).replace(/'/g, \"''\");\nconst catOv = JSON.stringify(body.categoryOverrides || {}).replace(/'/g, \"''\");\nconst sql = `INSERT INTO site_config (id, hero_image, benefits, category_overrides, updated_at)\nVALUES (1, '${hero}', '${benefits}'::jsonb, '${catOv}'::jsonb, NOW())\nON CONFLICT (id) DO UPDATE SET\n  hero_image = EXCLUDED.hero_image,\n  benefits = EXCLUDED.benefits,\n  category_overrides = EXCLUDED.category_overrides,\n  updated_at = NOW();`;\nreturn [{ json: { sql } }];"
      }
    },
    {
