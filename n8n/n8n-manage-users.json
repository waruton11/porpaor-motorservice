      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst id = parseInt(b.id);\nconst sql = id ? `DELETE FROM users WHERE id = ${id} AND role <> 'owner';` : 'SELECT 1;';\nreturn [{ json: { sql } }];"
      }
