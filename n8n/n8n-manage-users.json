    {
      "id": "us-s-002",
      "name": "Build user SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst esc = (s) => (s == null || s === '') ? 'NULL' : `'${String(s).replace(/'/g, \"''\")}'`;\nconst num = (n) => (n == null || n === '' || isNaN(Number(n))) ? 'NULL' : Number(n);\nconst act = (b.active === false) ? 'false' : 'true';\nlet sql;\nif (b.id) {\n  const sets = [`username = ${esc(b.username)}`, `role = ${esc(b.role)}`, `name = ${esc(b.name)}`, `active = ${act}`];\n  if (b.password) sets.push(`password = ${esc(b.password)}`);\n  sql = `UPDATE users SET ${sets.join(', ')} WHERE id = ${num(b.id)};`;\n} else {\n  sql = `INSERT INTO users (username, password, role, name, active) VALUES (${esc(b.username)}, ${esc(b.password)}, ${esc(b.role)}, ${esc(b.name)}, ${act}) ON CONFLICT (username) DO UPDATE SET password = EXCLUDED.password, role = EXCLUDED.role, name = EXCLUDED.name, active = EXCLUDED.active;`;\n}\nreturn [{ json: { sql } }];"
      }
    },
    {
