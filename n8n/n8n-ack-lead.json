      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst userId = body.userId;\nif (!userId) return [{ json: { skip: true } }];\n\nfunction qr(items) {\n  return { items: items.map(it => ({ type: 'action', action: { type: 'message', label: it.label, text: it.text } })) };\n}\n\nconst message = {\n  type: 'text',\n  text: 'ขอบคุณที่สนใจ Honda กับ ป.เปา ครับ 🙏\\nทีมงานได้รับรุ่นที่คุณเลือกแล้ว เดี๋ยวเจ้าหน้าที่ติดต่อกลับนะครับ\\n\\nลูกค้าสะดวกทำสัญญาที่สาขาไหนครับ',\n  quickReply: qr([\n    { label: '📍 วังน้อย', text: 'สะดวกทำสัญญาที่สาขาวังน้อย' },\n    { label: '📍 นครหลวง', text: 'สะดวกทำสัญญาที่สาขานครหลวง' },\n    { label: 'ทำสัญญานอกสถานที่', text: 'สะดวกทำสัญญานอกสถานที่' }\n  ])\n};\n\nreturn [{ json: { userId, message, token: 's6yXmBDu8IHtcIJA54MOVUqxVPNUSwht/oAxwGR+HyZ2H6cbrRS+i2BGQzfQRsCk8rUiVuGiYVSFVqsgW5SJXNIZHi736tS59Q/yJMP7TVfCA0Lot7p1NYu8ERe2tvh3ipTN12+bFfCTQ/8U0ShzYAdB04t89/1O/w1cDnyilFU=' } }];"
      }
    },
    {
      "id": "ack-005",
      "name": "Show Typing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/chat/loading/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Build ack').item.json.token }}"
