        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst esc = (s) => (s == null || s === '') ? 'NULL' : `'${String(s).replace(/'/g, \"''\")}'`;\nconst lit = (s) => String(s == null ? '' : s).replace(/'/g, \"''\");\nconst uid = lit(b.line_user_id);\nif (!uid) return [{ json: { sql: 'SELECT 1;', ok: false } }];\nconst sets = [];\nif (b.status !== undefined) sets.push(`status = ${esc(b.status)}`);\nif (b.assignee !== undefined) sets.push(`assignee = ${esc(b.assignee)}`);\nif (b.display_name !== undefined) sets.push(`display_name = ${esc(b.display_name)}`);\nif (b.note !== undefined) sets.push(`note = ${esc(b.note)}`);\nif (b.purchase_date !== undefined) sets.push(`purchase_date = ${esc(b.purchase_date)}`);\nsets.push('updated_at = NOW()');\nconst sql = `UPDATE customers SET ${sets.join(', ')} WHERE line_user_id = '${uid}';`;\nreturn [{ json: { sql } }];"
      }
